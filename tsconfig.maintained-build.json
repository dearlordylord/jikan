{
  "extends": "./tsconfig.maintained.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist/maintained",
    "rootDir": ".",
    "module": "commonjs"
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
