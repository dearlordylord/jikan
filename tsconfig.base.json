{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "Node16",
    "target": "ES2022",
    "module": "Node16",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "paths": {
      "@jikan0/adapters": [
        "./adapters/src/index.ts"
      ],
      "@jikan0/fsm": [
        "./fsm/src/index.ts"
      ],
      "@jikan0/react": [
        "./react/src/index.ts"
      ],
      "@jikan0/react-time-gremlin": [
        "./react-time-gremlin/src/index.ts"
      ],
      "@jikan0/reference-react": [
        "./reference-react/src/index.ts"
      ],
      "@jikan0/test-utils": [
        "./test-utils/src/index.ts"
      ],
      "@jikan0/ui": [
        "./ui/src/index.ts"
      ],
      "@jikan0/ui-react-utils": [
        "./ui-react-utils/src/index.ts"
      ],
      "@jikan0/utils": [
        "./utils/src/index.ts"
      ],
      "jikan0": [
        "./facade/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
