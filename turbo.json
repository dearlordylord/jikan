{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.maintained*.json",
    "tools/build-package.cjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@jikan0/web-demo#build": {
      "dependsOn": ["^build"],
      "outputs": ["../dist/reference-react-app/**"]
    }
  }
}
